{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "types": ["jest", "node"]
  },
  "include": ["src", "src/generated/**/*", "__tests__/**/*"]
}